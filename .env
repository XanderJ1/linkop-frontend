# The only env file, used by `npm run dev`, `npm run build` and Vercel.

# Local API. Switch back to the online API before committing or deploying:
# VITE_APP_SERVER_API_URL=https://api-linkop.duckdns.org/graphql
# VITE_APP_SERVER_ORIGIN=https://api-linkop.duckdns.org
VITE_APP_SERVER_API_URL=http://localhost:8000/graphql
VITE_APP_SERVER_ORIGIN=http://localhost:8000
# Local Keycloak. Online one: VITE_KEYCLOAK_URL=https://auth-linkop.duckdns.org
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=linkop
VITE_KEYCLOAK_CLIENT_ID=linkop

# Optional — enables cover photo uploads on the event form
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=