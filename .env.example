# Copy to .env (shared), .env.development (npm run dev) and
# .env.production (npm run build). Mode files override .env.

# --- .env ---
VITE_KEYCLOAK_REALM=linkop
VITE_KEYCLOAK_CLIENT_ID=linkop

# Optional — enables cover photo uploads on the event form
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- .env.development ---
# VITE_APP_SERVER_API_URL=http://localhost:8000/graphql
# VITE_APP_SERVER_ORIGIN=http://localhost:8000
# VITE_KEYCLOAK_URL=http://localhost:8080

# --- .env.production ---
# VITE_APP_SERVER_API_URL=https://api.your-domain.com/graphql
# VITE_APP_SERVER_ORIGIN=https://api.your-domain.com
# VITE_KEYCLOAK_URL=https://auth.your-domain.com
