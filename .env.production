# Deployed build — loaded by `npm run build` (including on Vercel).
# Committed on purpose: every VITE_ value ends up in the browser bundle, so
# nothing here is secret. Don't put secrets in this file.
VITE_APP_SERVER_API_URL=https://api-linkop.duckdns.org/graphql
VITE_APP_SERVER_ORIGIN=https://api-linkop.duckdns.org
VITE_KEYCLOAK_URL=https://auth-linkop.duckdns.org
VITE_KEYCLOAK_REALM=linkop
VITE_KEYCLOAK_CLIENT_ID=linkop
